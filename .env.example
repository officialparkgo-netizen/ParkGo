# =============================================================================
# ParkGo — environment configuration
# Copy to `.env.local` and fill in. EVERY integration has a mock fallback, so
# the app runs end-to-end with NONE of these set (PARKGO_MODE defaults to mock).
# =============================================================================

# ----- Runtime mode ----------------------------------------------------------
# "mock"  -> in-memory seed data, simulated payments/camera/AI, no external calls
# "live"  -> use the configured providers below
PARKGO_MODE=mock
NEXT_PUBLIC_PARKGO_MODE=mock

# Public site URL (used for canonical URLs, sitemap, OpenGraph).
# MUST be set in production — every canonical and every og:image is built from
# it, so if this stays on localhost the share cards resolve to a dead host and
# WhatsApp/LinkedIn/Slack render your links with no preview at all.
#   production: NEXT_PUBLIC_SITE_URL=https://www.parkgo.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Database / Auth / Realtime / Storage (Supabase) -----------------------
# Used when PARKGO_MODE=live. See supabase/migrations for the schema + RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Payments: Stripe Connect (marketplace split payments) -----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform commission (basis points). Defaults applied in mock mode.
PARKGO_COMMISSION_PARKING_BPS=1800   # ~18% on parking
PARKGO_COMMISSION_TRANSFER_BPS=1200  # ~12% on transfers

# ----- Maps & live location (Mapbox or Google Maps) --------------------------
NEXT_PUBLIC_MAPS_PROVIDER=mock        # mock | mapbox | google
# Also powers postcode/town suggestions in the search box, for places we don't
# already serve. Two things catch people out:
#   1. It must be the PUBLIC token (pk.…). A secret token is rejected.
#   2. It must NOT have a URL restriction. Geocoding is called server-side, so
#      the request carries no Referer and a URL-restricted token returns 403.
# To check a deployment: /api/geo/suggest?q=sw1a&diag=1 reports the exact
# outcome (and never echoes the token).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ----- Live camera (IP/RTSP -> HLS/WebRTC) -----------------------------------
CAMERA_PROVIDER=mock                  # mock | hls | webrtc
CAMERA_SIGNING_SECRET=

# ----- Identity / KYC (Stripe Identity or Onfido) ----------------------------
KYC_PROVIDER=mock                     # mock | stripe-identity | onfido
ONFIDO_API_TOKEN=

# ----- Notifications (push + email) ------------------------------------------
NOTIFICATIONS_PROVIDER=mock           # mock | expo | resend | sendgrid
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="ParkGo <no-reply@parkgo.ai>"

# ----- Support desk ----------------------------------------------------------
# Inbound email → support thread. Two ways in; set whichever fits.
# 1) Resend: Domains -> Receiving (MX records), then a webhook on the
#    "email.received" event pointing at https://<site>/api/support/inbound.
#    Resend signs with Svix and cannot send custom headers, so paste the
#    webhook's whsec_... signing secret here.
RESEND_WEBHOOK_SECRET=
# 2) Any other provider: post {from, subject, text} with this value in an
#    X-ParkGo-Secret header.
# With neither set the endpoint returns 404 and accepts nothing.
SUPPORT_INBOUND_SECRET=
# Web push for on-call staff. Generate with: npx web-push generate-vapid-keys
# Unset = the "Phone alerts" button never renders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:info@parkgo.ai"

# ----- AI (journey optimisation, pricing hints, translation) -----------------
AI_PROVIDER=mock                      # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- Support translation ----------------------------------------------------
# Visitor messages render into English for the team; agent replies render into
# the visitor's language. Originals are always kept. Unset = nothing translated.
# Google is the default when both keys exist (TRANSLATE_PROVIDER=deepl to
# override; ignored unless that provider's key is set).
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
# TRANSLATE_PROVIDER=google

# ----- Blog ------------------------------------------------------------------
# IndexNow: publishing a post pings Bing/Yandex immediately. Any 32+ char hex
# string; the middleware serves the /{key}.txt proof file from this variable.
INDEXNOW_KEY=
