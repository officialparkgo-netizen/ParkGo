# =============================================================================
# ParkGo — environment configuration
# Copy to `.env.local` and fill in. EVERY integration has a mock fallback, so
# the app runs end-to-end with NONE of these set (PARKGO_MODE defaults to mock).
# =============================================================================

# ----- Runtime mode ----------------------------------------------------------
# "mock"  -> in-memory seed data, simulated payments/camera/AI, no external calls
# "live"  -> use the configured providers below
PARKGO_MODE=mock
NEXT_PUBLIC_PARKGO_MODE=mock

# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Database / Auth / Realtime / Storage (Supabase) -----------------------
# Used when PARKGO_MODE=live. See supabase/migrations for the schema + RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Payments: Stripe Connect (marketplace split payments) -----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform commission (basis points). Defaults applied in mock mode.
PARKGO_COMMISSION_PARKING_BPS=1800   # ~18% on parking
PARKGO_COMMISSION_TRANSFER_BPS=1200  # ~12% on transfers

# ----- Maps & live location (Mapbox or Google Maps) --------------------------
NEXT_PUBLIC_MAPS_PROVIDER=mock        # mock | mapbox | google
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ----- Live camera (IP/RTSP -> HLS/WebRTC) -----------------------------------
CAMERA_PROVIDER=mock                  # mock | hls | webrtc
CAMERA_SIGNING_SECRET=

# ----- Identity / KYC (Stripe Identity or Onfido) ----------------------------
KYC_PROVIDER=mock                     # mock | stripe-identity | onfido
ONFIDO_API_TOKEN=

# ----- Notifications (push + email) ------------------------------------------
NOTIFICATIONS_PROVIDER=mock           # mock | expo | resend | sendgrid
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="ParkGo <hello@parkgo.example>"

# ----- AI (journey optimisation, pricing hints, translation) -----------------
AI_PROVIDER=mock                      # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
